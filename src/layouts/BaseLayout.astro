---
import "../styles/globals.css";
import Navigation from "../components/Navigation";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ZEALED FUJOSHI — Official Press & Podcast Outlet",
  description = "High-fashion anime editorial, convention journalism, and pop-culture press outlet.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head
    ><link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#120A17" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body
    class="bg-surface text-porcelain overflow-x-hidden selection:bg-razzmatazz/30 selection:text-porcelain"
  >
    <!-- Background Grid Texture -->
    <div
      class="fixed inset-0 pointer-events-none opacity-[0.03] z-0"
      style="background-image: radial-gradient(circle at 20px 20px, #FDFFFC 1px, transparent 1px); background-size: 40px 40px;"
    >
    </div>

    <svg class="hidden absolute aria-hidden">
      <defs>
        <filter
          id="water-glass"
          x="-20%"
          y="-20%"
          width="140%"
          height="140%"
          filterUnits="objectBoundingBox"
        >
          <!-- Generate smooth liquid turbulence -->
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.012 0.025"
            numOctaves="2"
            result="noise"></feTurbulence>

          <!-- Refract the backdrop content -->
          <feDisplacementMap
            in="SourceGraphic"
            in2="noise"
            scale="12"
            xChannelSelector="R"
            yChannelSelector="G"
            result="refracted"></feDisplacementMap>

          <!-- Liquid specular highlight (light sheen) -->
          <feSpecularLighting
            in="noise"
            surfaceScale="2.5"
            specularConstant="1.4"
            specularExponent="25"
            lighting-color="#ffffff"
            result="light"
          >
            <feDistantLight azimuth="135" elevation="55"></feDistantLight>
          </feSpecularLighting>

          <!-- Composite specular light over refracted card content -->
          <feComposite
            in="light"
            in2="SourceGraphic"
            operator="in"
            result="specular"></feComposite>
          <feBlend mode="screen" in="specular" in2="refracted" result="final"
          ></feBlend>
        </filter>
      </defs>
    </svg>

    <Navigation client:idle />

    <main class="relative z-10 min-h-screen">
      <slot />
    </main>

    <Footer />

    <!-- Lightweight 60fps Native Scroll Reveal Script -->

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("opacity-100", "translate-y-0");
                entry.target.classList.remove("opacity-0", "translate-y-8");
                observer.unobserve(entry.target); // Stops observing once revealed
              }
            });
          },
          { threshold: 0.1 },
        );

        // Target all reveal elements
        document
          .querySelectorAll(".gsap-reveal, .reveal, .reveal-up, .reveal-grid")
          .forEach((el) => {
            el.classList.add(
              "transition-all",
              "duration-700",
              "ease-out",
              "opacity-0",
              "translate-y-8",
            );
            observer.observe(el);
          });
      });
    </script>
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        // Disable trail on touch devices to save battery/cpu
        if (window.matchMedia("(pointer: coarse)").matches) return;

        const colour = "#f61067";
        const sparkles = 30;
        const stars: HTMLDivElement[] = [];
        const starData: {
          x: number;
          y: number;
          vx: number;
          vy: number;
          life: number;
        }[] = [];

        let mouseX = 0;
        let mouseY = 0;

        // Pre-create element pool
        for (let i = 0; i < sparkles; i++) {
          const charDiv = document.createElement("div");

          charDiv.style.position = "fixed";
          charDiv.style.top = "0";
          charDiv.style.left = "0";
          charDiv.style.zIndex = "9999";
          charDiv.style.fontFamily = "monospace";
          charDiv.style.fontWeight = "700";
          charDiv.style.fontSize = "12px";
          charDiv.style.color = colour;
          charDiv.style.userSelect = "none";
          charDiv.style.pointerEvents = "none";
          charDiv.style.opacity = "0";
          charDiv.style.willChange = "transform, opacity";

          charDiv.textContent = i % 2 === 0 ? "Z" : "F";

          document.body.appendChild(charDiv);
          stars.push(charDiv);
          starData.push({
            x: 0,
            y: 0,
            vx: 0,
            vy: 0,
            life: 0,
          });
        }

        let activeIndex = 0;

        window.addEventListener(
          "mousemove",
          (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;

            const particle = starData[activeIndex];

            particle.x = mouseX;
            particle.y = mouseY;
            particle.vx = (Math.random() - 0.5) * 1.5;
            particle.vy = Math.random() * 2 + 1;
            particle.life = 1;

            activeIndex = (activeIndex + 1) % sparkles;
          },
          { passive: true },
        );

        // ============================================
        // CARTOON FPS
        // ============================================

        const FPS = 24;
        let lastFrame = 0;

        function render(timestamp: number) {
          if (timestamp - lastFrame >= 1000 / FPS) {
            lastFrame = timestamp;

            for (let i = 0; i < sparkles; i++) {
              const p = starData[i];
              const el = stars[i];

              if (p.life > 0) {
                p.life -= 0.05;
                p.x += p.vx;
                p.y += p.vy;

                el.style.transform = `translate3d(${p.x}px, ${p.y}px, 0) scale(${p.life})`;

                el.style.opacity = p.life.toString();
              } else {
                el.style.opacity = "0";
              }
            }
          }

          requestAnimationFrame(render);
        }

        requestAnimationFrame(render);
      });
    </script>
  </body>
</html>
