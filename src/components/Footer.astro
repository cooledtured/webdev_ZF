---
import { Mail } from "lucide-react";
import {
  siFacebook,
  siX,
  siInstagram,
  siYoutube,
  siTumblr,
  siTwitch,
  siSpotify,
  siApplepodcasts,
} from "simple-icons";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const navLinks = [
  { name: "Home", href: `${baseUrl}/` },
  { name: "Podcasts", href: `${baseUrl}/podcasts` },
  { name: "Posts", href: `${baseUrl}/posts` },
  { name: "Contact & PR", href: `${baseUrl}/contact` },
];

const socialLinks = [
  { name: "Facebook", url: "https://www.facebook.com/zealedfujoshi", path: siFacebook.path },
  { name: "X (Twitter)", url: "https://twitter.com/zealedfujoshi", path: siX.path },
  { name: "Instagram", url: "https://www.instagram.com/zealedfujoshi", path: siInstagram.path },
  { name: "YouTube", url: "https://www.youtube.com/c/ZealedFujoshi", path: siYoutube.path },
  { name: "Tumblr", url: "https://zealedfujoshi.tumblr.com/", path: siTumblr.path },
  { name: "Twitch", url: "https://twitch.tv/zealedfujoshi", path: siTwitch.path },
  { name: "Spotify", url: "https://open.spotify.com/show/61re9eciOLavgZ9wPkBLOr?si=e5cdd14601914787", path: siSpotify.path },
  { name: "Apple Podcasts", url: "https://podcasts.apple.com/us/podcast/zealed-fujoshi-a-yaoi-boys-love-bl-podcast/id1530688864", path: siApplepodcasts.path },
];

const currentYear = new Date().getFullYear();
---

<footer class="relative z-10 bg-surface border-t border-white/10 text-porcelain py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-12 border-b border-white/10">
      
      <!-- Brand & Tagline -->
      <div class="md:col-span-6 space-y-4">
        <a href={`${baseUrl}/`} class="inline-block">
          <h2 class="text-2xl font-black tracking-wider uppercase">
            <span class="text-porcelain">ZEALED</span>
            <span class="text-razzmatazz">FUJOSHI</span>
          </h2>
        </a>
        <p class="text-sm text-porcelain/85 max-w-sm leading-relaxed">
          A show heavily focused on the hottest and latest boys love / yaoi anime, manga, manhwa and webtoon.
        </p>
      </div>

      <!-- Quick Links -->
      <div class="md:col-span-3 space-y-3">
        <h3 class="text-xs font-mono uppercase text-razzmatazz tracking-widest font-semibold">
          [ NAVIGATION ]
        </h3>
        <ul class="space-y-2 text-sm text-porcelain/85">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-razzmatazz transition-colors block py-0.5">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Social Channels -->
      <div class="md:col-span-3 space-y-3">
        <h3 class="text-xs font-mono uppercase text-razzmatazz tracking-widest font-semibold">
          [ OFFICIAL SOCIALS ]
        </h3>

        <ul class="flex flex-wrap items-center gap-3">
          {socialLinks.map((social) => (
            <li>
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.name}
                class="p-2.5 rounded-xl bg-white/[0.05] border border-white/10 hover:border-razzmatazz hover:text-razzmatazz transition-all block"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d={social.path} />
                </svg>
              </a>
            </li>
          ))}

          <!-- Spotify Support -->
          <li>
            <a
              href="https://creators.spotify.com/pod/profile/zealed-fujoshi/support"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Spotify Support"
              class="p-2.5 rounded-xl bg-white/[0.05] border border-white/10 hover:border-razzmatazz hover:text-razzmatazz transition-all block"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
              </svg>
            </a>
          </li>

          <!-- Email -->
          <li>
            <a
              href="mailto:zealedfujoshi@gmail.com"
              aria-label="Email Us"
              class="p-2.5 rounded-xl bg-white/[0.05] border border-white/10 hover:border-razzmatazz hover:text-razzmatazz transition-all block"
            >
              <Mail size={16} />
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs font-mono text-porcelain/60">
      <p>© {currentYear} ZEALED FUJOSHI PRESS. All rights reserved.</p>
    </div>
  </div>
</footer>