---
/**
 * Hero.astro
 * High-impact, editorial-style hero element for Zealed Fujoshi Press.
 * Features GSAP animations and brand-aligned colors.
 */
import { Image } from "astro:assets";
import heroBackground from "../assets/background.webp";
import VideoSpotlight from "./features/VideoSpotlight.astro";
---

<section
  class="relative min-h-[92vh] flex items-center justify-center pt-28 pb-16 overflow-hidden bg-surface"
>
  <!-- Background Image -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <Image
      id="hero-bg"
      src={heroBackground}
      alt=""
      fetchpriority="high"
      decoding="async"
      style="filter:blur(0.5px);"
      class="w-full h-full object-cover opacity-40 scale-125 origin-center"
    />
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left: Hero Headline & CTAs -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <!-- Main Typography -->
        <h1
          class="text-5xl sm:text-6xl md:text-7xl font-black tracking-tight leading-none uppercase hero-title"
        >
          <span class="text-porcelain block">ZEALED</span>
          <span class="text-razzmatazz block">FUJOSHI</span>
        </h1>

        <p
          class="text-xl sm:text-2xl text-porcelain/85 font-light leading-relaxed max-w-xl hero-element"
        >
          A show heavily focused on the hottest and latest boys love / yaoi
          anime, manga, manwha and webtoon.
        </p>

        <!-- Buttons -->
        <div class="flex flex-wrap gap-4 pt-4 hero-element">
          <a
            href="/posts"
            class="px-8 py-3.5 rounded-xl bg-[#D90052] text-porcelain font-bold hover:shadow-lg hover:shadow-razzmatazz/30 hover:bg-[#B80045] transition-all duration-300 flex items-center gap-2 group cursor-pointer"
          >
            <span class="text-porcelain group-hover:text-porcelain"
              >EXPLORE POSTS</span
            >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="white"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="group-hover:translate-x-1 transition-transform"
            >
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>

          <a
            href="/podcasts"
            class="group relative overflow-visible card-glass px-8 py-3.5 rounded-xl text-porcelain font-semibold transition-all duration-300 inline-flex items-center justify-center"
            >LISTEN TO PODCAST
          </a>
        </div>
      </div>

      <!-- Right: Video Spotlight Carousel -->
      <div class="lg:col-span-5 hero-element">
        <VideoSpotlight />
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        gsap.to("#hero-bg", {
          yPercent: 20,
          ease: "none",
          scrollTrigger: {
            trigger: "section",
            start: "top top",
            end: "bottom top",
            scrub: true,
          },
        });

        const tl = gsap.timeline({ defaults: { ease: "power4.out" } });
        tl.from(".hero-title span", {
          y: 40,
          opacity: 0,
          duration: 1,
          stagger: 0.1,
        });
      });
    });
  });
</script>
