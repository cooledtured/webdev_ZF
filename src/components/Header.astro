---
// src/components/Header.astro
// Main header with logo and branding
---

<header class="sticky top-0 z-50 bg-zf-charcoal/95 backdrop-blur-sm border-b border-zf-gray">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 bg-gradient-to-br from-zf-crimson to-zf-magenta rounded-lg flex items-center justify-center">
            <span class="text-zf-white font-jakarta font-bold text-lg">ZF</span>
          </div>
          <div class="hidden sm:block">
            <h1 class="text-lg font-jakarta font-bold text-zf-white group-hover:text-zf-crimson transition-colors">
              ZEALED FUJOSHI
            </h1>
            <p class="text-xs text-porcelain/80 font-inter">PRESS & PODCAST</p>
          </div>
        </a>
      </div>

      <!-- Brand Statement -->
      <div class="hidden md:flex items-center gap-2">
        <div class="text-center">
          <p class="text-xs font-inter text-porcelain/80 tracking-wider">OFFICIAL ANIME & BL PRESS</p>
          <p class="text-xs font-inter text-zf-cyan">Est. Press Coverage Since 2020</p>
        </div>
      </div>
    </div>
  </div>
</header>

<style></style>