---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PartnerMarquee from '../components/PartnerMarquee';
import PressBadges from '../components/PressBadges';
import PodcastPlayer from '../components/PodcastPlayer';
import { ArrowRight } from 'lucide-react';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const featuredPosts = allPosts
  .filter(post => post.data.featured)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="ZEALED FUJOSHI — Official Press & Podcast Outlet">
  <Hero />

  <!-- Event Coverage Showcase -->
  <section class="relative py-20 bg-surface border-b border-white/5 reveal-up">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12 text-center">
        <h2 class="text-4xl md:text-5xl font-black text-porcelain mt-3">ON THE GROUND</h2>
        <p class="text-porcelain/60 mt-2">Our latest dispatches from the world's premier anime events.</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <div class="aspect-video relative rounded-2xl overflow-hidden card-glass group">
          <img src="/events/acen-horz-logo-retina.webp" alt="Anime Central" class="w-full h-full object-contain p-4 group-hover:scale-105 transition-all duration-500" style="filter: brightness(3.5);"/>
          <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-60"></div>
        </div>
        <div class="aspect-video relative rounded-2xl overflow-hidden card-glass group">
          <img src="/events/AMKE_26_Logo_Primary_center.webp" alt="Anime Magic" class="w-full h-full object-contain p-4 group-hover:scale-105 transition-all duration-500" />
          <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-60"></div>
        </div>
        <div class="aspect-video relative rounded-2xl overflow-hidden card-glass group">
          <img src="/events/c2e2-logo-250px.webp" alt="C2E2" class="w-full h-full object-contain p-4 group-hover:scale-105 transition-all duration-500" />
          <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-60"></div>
        </div>
        <div class="aspect-video relative rounded-2xl overflow-hidden card-glass group">
          <img src="/events/weblogo3.webp" alt="Event Logo" class="w-full h-full object-contain p-4 group-hover:scale-105 transition-all duration-500" />
          <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-60"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Partner Logo Ticker (Local Assets) -->
  <PartnerMarquee client:visible />

  <!-- Editorial Press Feed Grid -->
  <section class="relative py-20 bg-surface border-b border-white/5 reveal-up">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12 text-center">
        <h2 class="text-4xl md:text-5xl font-black text-porcelain mt-3">FEATURED STORIES</h2>
        <p class="text-porcelain/60 mt-2">The most impactful coverage and exclusive insights.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 reveal-grid">
        {featuredPosts.map((post) => (
          <div class="p-6 rounded-2xl card-glass hover:border-red-500/40 transition-all group flex flex-col justify-between">
            <div>
              <span class="text-xs font-mono text-red-400 border border-red-500/30 px-2.5 py-1 rounded-full bg-red-500/10">[ {post.data.category.replace(/_/g, ' ')} ]</span>
              <h3 class="text-xl font-bold text-white mt-4 mb-2 group-hover:text-red-400 transition-colors">{post.data.title}</h3>
              <p class="text-sm text-white/60 mb-6 leading-relaxed line-clamp-3">{post.data.summary}</p>
            </div>
            <a href={`/posts/${post.slug}`} class="text-xs font-mono text-red-400 group-hover:underline flex items-center gap-1">
              <span>READ ARTICLE</span>
              <ArrowRight size={12} />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
