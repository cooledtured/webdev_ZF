---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection('posts');
  const sorted = posts.sort((a, b) => {
    if (a.data.featured !== b.data.featured) {
      return (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0);
    }
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  });

  // Automatically generates /posts, /posts/2, /posts/3...
  return paginate(sorted, { pageSize: 6 });
}

// Astro automatically passes the page object via props
const { page } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title={`Posts (Page ${page.currentPage}) - ZEALED FUJOSHI`}>
  <div class="min-h-screen bg-gradient-to-b from-black/40 to-black pt-24 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="mb-16 text-center">
        <h1 class="text-5xl md:text-6xl font-bold mb-4">Posts</h1>
      </div>

      <!-- Articles List -->
      <div class="space-y-8">
        {page.data.map((article) => (
          <a href={`${baseUrl}/posts/${article.slug}`} class="group block">
            <div class="relative rounded-xl overflow-hidden card-glass hover:border-red-500/30 transition-all p-6 lg:p-8 flex flex-col md:flex-row gap-6">
              <div class="flex-1">
                <span class="text-xs font-bold uppercase tracking-wider px-2 py-1 rounded-full bg-red-500/10 text-red-400 border border-red-500/20 inline-block mb-4">
                  {article.data.category.replace(/_/g, ' ')}
                </span>
                <h2 class="text-2xl md:text-3xl font-bold mb-3 group-hover:text-red-400 transition-colors">
                  {article.data.title}
                </h2>
                <p class="text-base text-white/60 line-clamp-3 mb-4">{article.data.summary}</p>
                <div class="text-sm text-white/50 flex gap-4">
                  <span>By {article.data.author}</span>
                  <span>•</span>
                  <span>{article.data.readingTime} min read</span>
                </div>
              </div>
              {article.data.coverImage && (
                <div class="hidden md:block flex-shrink-0 w-56 h-40 rounded-lg overflow-hidden bg-white/5">
                  <img src={article.data.coverImage} alt={article.data.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" />
                </div>
              )}
            </div>
          </a>
        ))}
      </div>

      <!-- Pagination Navigation Controls -->
      <div class="flex items-center justify-between mt-16 pt-8 border-t border-white/10">
        {page.url.prev ? (
          <a href={`${baseUrl}/${page.url.prev}`} class="px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-sm font-medium hover:bg-white/10 transition-colors">
            ← Previous
          </a>
        ) : (
          <span class="px-4 py-2 text-sm text-white/20 cursor-not-allowed">← Previous</span>
        )}

        <span class="text-sm text-white/50">
          Page <strong class="text-white">{page.currentPage}</strong> of {page.lastPage}
        </span>

        {page.url.next ? (
          <a href={`${baseUrl}/${page.url.next}`} class="px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-sm font-medium hover:bg-white/10 transition-colors">
            Next →
          </a>
        ) : (
          <span class="px-4 py-2 text-sm text-white/20 cursor-not-allowed">Next →</span>
        )}
      </div>
    </div>
  </div>
</BaseLayout>
